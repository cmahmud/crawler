# Required secrets. Replace both before starting Compose.
SYNCRAWLER_POSTGRES_PASSWORD=replace-with-a-long-random-password
SYNCRAWLER_API_TOKEN=replace-with-a-long-random-bearer-token

# API binds to loopback by default so a reverse proxy can terminate TLS.
SYNCRAWLER_API_BIND=127.0.0.1
SYNCRAWLER_API_PORT=8080

# Crawl defaults.
SYNCRAWLER_MAX_PAGES=100
SYNCRAWLER_MAX_CONCURRENCY=10
SYNCRAWLER_MAX_RETRIES=2
SYNCRAWLER_RESPECT_ROBOTS=true
SYNCRAWLER_ALLOW_PRIVATE_NETWORKS=false
SYNCRAWLER_SITEMAP_DISCOVERY=true

# Browser escalation is available in the image but disabled by default.
SYNCRAWLER_BROWSER_ENABLED=false
SYNCRAWLER_BROWSER_TYPE=chromium
SYNCRAWLER_BROWSER_MAX_CONCURRENCY=2
SYNCRAWLER_BROWSER_TIMEOUT_SECONDS=45
SYNCRAWLER_BROWSER_SETTLE_SECONDS=0.25
# Keep Chromium sandboxing enabled unless your container host cannot support it.
SYNCRAWLER_BROWSER_CHROMIUM_SANDBOX=true

# Shared-service and worker tuning.
SYNCRAWLER_REDIS_KEY_PREFIX=syndcrawler
SYNCRAWLER_POSTGRES_POOL_MIN=1
SYNCRAWLER_POSTGRES_POOL_MAX=10
SYNCRAWLER_WORKER_POLL_INTERVAL=1
SYNCRAWLER_WORKER_ERROR_BACKOFF=5
SYNCRAWLER_RECRAWL_BATCH_SIZE=100
SYNCRAWLER_RECRAWL_LEASE_SECONDS=120
