{
  "name": "syndcrawler-tui",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "module": "src/index.tsx",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/*.test.ts",
    "check": "bun run typecheck && bun run test",
    "build": "mkdir -p dist && bun build --compile src/index.tsx --outfile dist/syndcrawler-tui"
  },
  "dependencies": {
    "@opentui/core": "^0.5.3",
    "@opentui/react": "^0.5.3",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "typescript": "^5.8.0"
  }
}
